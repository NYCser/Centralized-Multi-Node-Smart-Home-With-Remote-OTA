
# workers/email_notifier.py
"""
Email Notifier Worker
══════════════════════
Lắng nghe channel Redis "safety_alert" (gas/lửa) và gửi email cảnh báo
qua Gmail SMTP khi level="critical".

Luồng:
  safety_watchdog._save_alert() → Redis publish "safety_alert"
      → email_notifier nhận → lọc level=critical → gửi email

CHỈ gửi email cho gas/lửa (type="gas"/"fire", level="critical").
Bỏ qua thông báo "đã an toàn" (type="system", level="info") để tránh spam.

Có rate-limit: tối đa 1 email / room / COOLDOWN_SECONDS để tránh
gửi liên tục khi safety_watchdog lưu lại alert mỗi 5 phút (SAFETY_REPEAT_INTERVAL).
"""

import json
import logging
import os
import smtplib
import threading
import time
from datetime import datetime
from email.mime.text import MIMEText

from bridge.message_bus import MessageBus

# ══════════════════════════════════════════════════════════
# CONFIG — đọc từ biến môi trường (.env), KHÔNG hardcode mật khẩu
# ══════════════════════════════════════════════════════════

SMTP_SERVER   = os.getenv("SMTP_SERVER", "smtp.gmail.com")
SMTP_PORT     = int(os.getenv("SMTP_PORT", 587))
EMAIL_USER    = os.getenv("EMAIL_USER", "")        # vd: smarthome.alert@gmail.com
EMAIL_PASS    = os.getenv("EMAIL_APP_PASSWORD", "")  # Gmail App Password (16 ký tự, không phải mật khẩu thường)
EMAIL_TO      = os.getenv("EMAIL_TO", "")           # email nhận cảnh báo, có thể nhiều: "a@x.com,b@y.com"

COOLDOWN_SECONDS = int(os.getenv("EMAIL_COOLDOWN_SECONDS", 600))  # 10 phút / room

ROOM_NAME_MAP = {
    "kitchen_01":     "Phòng bếp",
    "living_room_01": "Phòng khách",
    "bedroom_01":      "Phòng ngủ",
}

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s][EMAIL] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger("email_notifier")

_last_sent: dict = {}  # room_id -> timestamp (epoch) lần gửi gần nhất
_lock = threading.Lock()


def _config_ok() -> bool:
    if not EMAIL_USER or not EMAIL_PASS or not EMAIL_TO:
        log.warning(
            "Email chưa được cấu hình đầy đủ (EMAIL_USER/EMAIL_APP_PASSWORD/EMAIL_TO "
            "thiếu trong .env) — bỏ qua gửi email."
        )
        return False
    return True


def _build_message(alert_type: str, room_id: str, message: str, timestamp: str) -> MIMEText:
    room_name = ROOM_NAME_MAP.get(room_id, room_id)
    type_label = "LỬA" if alert_type == "fire" else "💨 KHÍ GAS"

    subject = f"CẢNH BÁO {type_label} - {room_name}"
    body = (
        f"HỆ THỐNG SMART HOME - CẢNH BÁO AN TOÀN\n"
        f"{'='*45}\n\n"
        f"Loại cảnh báo : {type_label}\n"
        f"Phòng         : {room_name} ({room_id})\n"
        f"Chi tiết      : {message}\n"
        f"Thời gian     : {timestamp}\n\n"
        f"{'='*45}\n"
        f"Hệ thống đã tự động: bật quạt thông gió, kích hoạt còi báo động "
        f"và khóa an toàn cho phòng này.\n"
        f"Vui lòng kiểm tra ngay.\n"
    )

    msg = MIMEText(body, "plain", "utf-8")
    msg["Subject"] = subject
    msg["From"] = EMAIL_USER
    msg["To"] = EMAIL_TO
    return msg


def send_alert_email(alert_type: str, room_id: str, message: str, timestamp: str) -> bool:
    if not _config_ok():
        return False

    msg = _build_message(alert_type, room_id, message, timestamp)
    recipients = [e.strip() for e in EMAIL_TO.split(",") if e.strip()]

    try:
        with smtplib.SMTP(SMTP_SERVER, SMTP_PORT, timeout=15) as server:
            server.starttls()
            server.login(EMAIL_USER, EMAIL_PASS)
            server.sendmail(EMAIL_USER, recipients, msg.as_string())
        log.info("Đã gửi email cảnh báo %s - %s → %s", alert_type, room_id, EMAIL_TO)
        return True
    except smtplib.SMTPAuthenticationError as e:
        log.error(
            "Lỗi xác thực Gmail — kiểm tra EMAIL_USER/EMAIL_APP_PASSWORD trong .env "
            "(phải dùng App Password, không phải mật khẩu Gmail thường): %s", e
        )
        return False
    except Exception as e:
        log.error("Gửi email thất bại: %s", e)
        return False


def _should_send(room_id: str) -> bool:
    """Rate-limit: chỉ gửi 1 email / room / COOLDOWN_SECONDS."""
    now = time.time()
    with _lock:
        last = _last_sent.get(room_id, 0)
        if now - last < COOLDOWN_SECONDS:
            return False
        _last_sent[room_id] = now
        return True


def _handle_alert(data: dict):
    alert_type = data.get("type", "")
    level      = data.get("level", "")
    room_id    = data.get("room") or data.get("location") or "unknown"
    message    = data.get("message", "")
    timestamp  = data.get("timestamp", datetime.now().strftime("%Y-%m-%d %H:%M:%S"))

    # CHỈ gửi email cho gas/lửa mức critical — bỏ qua "system"/"info" (thông báo an toàn)
    if alert_type not in ("gas", "fire"):
        return
    if level != "critical":
        return

    if not _should_send(room_id):
        log.debug("Bỏ qua gửi email %s/%s — đang trong cooldown %ds", room_id, alert_type, COOLDOWN_SECONDS)
        return

    send_alert_email(alert_type, room_id, message, timestamp)


def run():
    """Entry point — gọi từ gateway_main.py giống các worker khác."""
    if not _config_ok():
        log.warning("Email notifier khởi động nhưng CHƯA cấu hình — sẽ không gửi được email cho đến khi .env có đủ EMAIL_USER/EMAIL_APP_PASSWORD/EMAIL_TO")

    bus    = MessageBus.get_instance()
    redis  = bus.get_redis()
    pubsub = redis.pubsub()
    pubsub.subscribe("safety_alert")

    log.info("Email Notifier started — lắng nghe channel 'safety_alert' (chỉ gas/lửa critical)")

    for msg in pubsub.listen():
        if msg["type"] != "message":
            continue
        try:
            data = json.loads(msg["data"])
            _handle_alert(data)
        except json.JSONDecodeError:
            log.warning("safety_alert payload không phải JSON hợp lệ: %s", str(msg["data"])[:100])
        except Exception as e:
            log.error("Lỗi xử lý safety_alert: %s", e)


if __name__ == "__main__":
    run()




